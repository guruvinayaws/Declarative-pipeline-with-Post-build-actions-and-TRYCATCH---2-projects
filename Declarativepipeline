pipeline
{
    agent any
    stages
    {
        stage('ContDownload')
        {
            steps
            {
                git 'https://github.com/IntelliqDevops/maven'
            }
        }
         stage('ContBuild')
        {
            steps
            {
                sh 'mvn package'
            }
        }
        stage('ContDeployment')
        {
            steps
            {
                sh 'scp /var/lib/jenkins/workspace/DP-POST/webapp/target/webapp.war ubuntu@172.31.71.255:/var/lib/tomcat10/webapps/testapp.war'
            }
        }
        stage('ContTesting')
        {
            steps
            {
                git 'https://github.com/IntelliqDevops/FunctionalTesting'
                sh 'java -jar /var/lib/jenkins/workspace/DP-POST/testing.jar'
            }
        }
    
}
post
   {
       success
       {
           sh 'scp /var/lib/jenkins/workspace/DP-POST/webapp/target/webapp.war ubuntu@172.31.64.9:/var/lib/tomcat10/webapps/prodapp.war'
       }
       failure
       {
           echo "CI has failed"
       }
   }
}
